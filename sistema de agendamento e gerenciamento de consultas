def carregar_dados():
    """Carrega os dados de pacientes, médicos e consultas do arquivo JSON."""
    global pacientes, medicos, consultas
    if os.path.exists(ARQUIVO_DADOS):
        # A lógica de carregamento de dados é a mesma...
        # ... (Mantendo a função original)
        with open(ARQUIVO_DADOS, 'r', encoding='utf-8') as f:
            dados = json.load(f)

            # Recria objetos Paciente e Medico a partir dos dados do JSON
            pacientes = {
                cpf: Paciente(**p) for cpf, p in dados.get('pacientes', {}).items()
            }
            medicos = {
                crm: Medico(agenda=m.pop('agenda'), **m) for crm, m in dados.get('medicos', {}).items()
            }
            # Recria objetos Consulta
            consultas = [
                Consulta(**c) for c in dados.get('consultas', [])
            ]
        print(f"✅ Dados carregados com sucesso de {ARQUIVO_DADOS}.")
    else:
        print(f"⚠️ Arquivo de dados {ARQUIVO_DADOS} não encontrado. Iniciando com dados vazios.")

def salvar_dados():
    """Salva os dados de pacientes, médicos e consultas no arquivo JSON."""
    # A lógica de salvamento de dados é a mesma...
    dados_para_salvar = {
        'pacientes': {cpf: p.__dict__ for cpf, p in pacientes.items()},
        'medicos': {crm: m.__dict__ for crm, m in medicos.items()},
        'consultas': [c.__dict__ for c in consultas]
    }
    try:
        with open(ARQUIVO_DADOS, 'w', encoding='utf-8') as f:
            json.dump(dados_para_salvar, f, indent=4, ensure_ascii=False)
        # Não exibe a mensagem de sucesso aqui para evitar poluição do console a cada ação
    except Exception as e:
        print(f"❌ Erro ao salvar dados: {e}")

