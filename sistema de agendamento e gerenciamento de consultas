def gerar_receita():
    """Médico: Permite gerar uma receita para uma consulta (e aciona a impressão)."""
    print("\n--- Geração de Receita ---")

    consulta_index = input("Digite o NÚMERO da consulta REALIZADA para a receita: ").strip()
    try:
        index = int(consulta_index) - 1
        if 0 <= index < len(consultas):
            consulta = consultas[index]
            if consulta.status not in ["CONFIRMADA", "REALIZADA"]:
                 print(f"❌ Erro: A consulta precisa estar CONFIRMADA/REALIZADA para gerar receita. Status atual: {consulta.status}")
                 return

            if consulta.status != "REALIZADA":
                consulta.status = "REALIZADA"

            receita_texto = input("Digite o texto da Receita: ").strip()
            consulta.receita = receita_texto

            print(f"\n✅ Receita gerada para {pacientes[consulta.cpf_paciente].nome}.")
