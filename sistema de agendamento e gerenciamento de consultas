def calcular_idade(data_nasc_str):
    """Calcula a idade atual com base na data de nascimento (DD/MM/AAAA)."""
    try:
        data_nasc = datetime.strptime(data_nasc_str, "%d/%m/%Y").date()
    except ValueError:
        return None

    today = date.today()
    if data_nasc > today:
        return -1

    idade = today.year - data_nasc.year - ((today.month, today.day) < (data_nasc.month, data_nasc.day))
    return idade

# --- NOVA FUNÇÃO AUXILIAR PARA SELEÇÃO DE MÉDICO ---
def selecionar_medico():
    """Exibe a lista de médicos e permite a seleção por número."""
    if not medicos:
        print("❌ Nenhum médico cadastrado.")
        return None

    medicos_list = list(medicos.values())
    print("\n--- Lista de Médicos ---")
    for i, m in enumerate(medicos_list, 1):
        print(f"{i}. Dr(a). {m.nome} ({m.especialidade} - CRM: {m.crm})")

    while True:
        try:
            escolha = input("Selecione o NÚMERO do médico (ou 'v' para voltar): ").strip().lower()
            if escolha == 'v':
                return None

            index = int(escolha) - 1
            if 0 <= index < len(medicos_list):
                return medicos_list[index]
            else:
                print("⚠️ Número inválido. Tente novamente.")
        except ValueError:
            print("⚠️ Entrada inválida. Digite o número.")

