class Paciente:
    """Representa um paciente com dados pessoais, prioridade e status de pagamento."""
    def __init__(self, nome, data_nascimento, cpf, telefone, status_pagamento="Em Dia", **kwargs):
        self.nome = nome
        self.data_nascimento = data_nascimento
        self.cpf = cpf
        self.telefone = telefone
        self.status_pagamento = status_pagamento
        self.idade = calcular_idade(data_nascimento)
        # Ensure prioritario is set only if idade is not None
        self.prioritario = self.idade >= PRIORIDADE_IDADE if self.idade is not None else False

    def __str__(self):
        prioridade_msg = "PRIORITÁRIO" if self.prioritario else "NORMAL"
        return f"{self.nome} (Idade: {self.idade} | CPF: {self.cpf}) - Status: {self.status_pagamento} ({prioridade_msg})"

class Medico:
    """Representa um médico com dados, especialidade e agenda de disponibilidade."""
    def __init__(self, nome, especialidade, crm, agenda=None, **kwargs):
        self.nome = nome
        self.especialidade = especialidade
        self.crm = crm
        # Agenda é um dicionário: {'DD/MM/AAAA': ['HH:MM']}
        self.agenda = agenda if agenda is not None else {}

    def __str__(self):
        return f"Dr(a). {self.nome} ({self.especialidade} - {self.crm})"

    def adicionar_disponibilidade(self, data, horarios):
        """Adiciona horários na agenda. Horários deve ser uma lista de strings HH:MM."""
        # Implementação resumida
        if data not in self.agenda:
            self.agenda[data] = []

        horarios_atuais = set(self.agenda[data])
        horarios_atuais.update(horarios)
        self.agenda[data] = sorted(list(horarios_atuais))
        return True

    def remover_disponibilidade(self, data, horario):
        """Remove um horário específico da disponibilidade."""
        # Implementação resumida
        if data in self.agenda and horario in self.agenda[data]:
            self.agenda[data].remove(horario)
            if not self.agenda[data]:
                del self.agenda[data]
            return True
        return False

class Consulta:
    """Representa uma consulta agendada."""
    def __init__(self, cpf_paciente, crm_medico, data, horario, status="AGENDADA", receita="", **kwargs):
        self.cpf_paciente = cpf_paciente
        self.crm_medico = crm_medico
        self.data = data
        self.horario = horario
        self.status = status # AGENDADA, CONFIRMADA, CANCELADA, REALIZADA
        self.receita = receita

    def __str__(self):
        # Utiliza os dicionários globais para buscar informações
        paciente_nome = pacientes.get(self.cpf_paciente).nome if self.cpf_paciente in pacientes else "Desconhecido"
        medico_nome = medicos.get(self.crm_medico).nome if self.crm_medico in medicos else "Desconhecido"
        return f"Paciente: {paciente_nome} | Médico: Dr(a). {medico_nome} | Data: {self.data} às {self.horario} | Status: {self.status}"

