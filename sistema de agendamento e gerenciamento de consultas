# ... (Mantendo as funções cadastrar_paciente e cadastrar_medico originais) ...
def cadastrar_paciente():
    """Secretária: Cadastra um novo paciente, verifica duplicidade de CPF."""
    print("\n--- Cadastro de Paciente ---")
    nome = input("Nome completo: ").strip()

    while True:
        data_nascimento_input = input("Data de nascimento (DD/MM/AAAA): ").strip()
        idade = calcular_idade(data_nascimento_input)

        if idade is None:
            print("❌ Erro: Formato de data inválido. Use DD/MM/AAAA.")
        elif idade < 0 or idade > 150:
            print("❌ Erro: Idade calculada irrealista.")
        else:
            break

    while True:
        cpf = input("CPF (apenas números): ").strip()
        if not cpf:
            print("❌ Erro: CPF não pode ser vazio.")
        elif cpf in pacientes:
            print(f"❌ Erro: CPF '{cpf}' já cadastrado.")
        else:
            break

    telefone = input("Telefone: ").strip()

    # Status de Pagamento
    status_pagamento = "Em Dia" if input("Status de Pagamento (1- Em Dia, 2- Pendente): ") == '1' else "Pendente"

    novo_paciente = Paciente(nome, data_nascimento_input, cpf, telefone, status_pagamento)
    pacientes[cpf] = novo_paciente

    print(f"\n✅ Paciente {novo_paciente.nome} cadastrado. Prioritário: {'Sim' if novo_paciente.prioritario else 'Não'}")
    salvar_dados()
    return novo_paciente

def cadastrar_medico():
    """Médico: Cadastra um novo médico, verifica duplicidade de CRM."""
    print("\n--- Cadastro de Médico ---")
    nome = input("Nome completo do(a) médico(a): ").strip()
    especialidade = input("Especialidade: ").strip()

    while True:
        crm = input("CRM: ").strip().upper()
        if not crm:
            print("❌ Erro: CRM não pode ser vazio.")
        elif crm in medicos:
            print(f"❌ Erro: CRM '{crm}' já cadastrado.")
        else:
            break

    novo_medico = Medico(nome, especialidade, crm)
    medicos[crm] = novo_medico

    print(f"\n✅ Médico(a) Dr(a). {novo_medico.nome} ({novo_medico.especialidade}) cadastrado(a).")
    salvar_dados()

