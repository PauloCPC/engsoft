def agendar_consulta():
    """Secretária: Permite o agendamento de uma nova consulta, exibindo médicos e horários."""
    print("\n--- Agendamento de Consulta ---")
    if not pacientes or not medicos:
        print("❌ ERRO: É necessário ter pacientes e médicos cadastrados.")
        return

    # 1. Seleção do Paciente
    cpf = input("Digite o CPF do paciente (ou deixe vazio para cadastrar): ").strip()
    paciente_obj = pacientes.get(cpf)

    if not paciente_obj:
        print("Paciente não encontrado.")
        if input("Deseja cadastrar agora? (s/n): ").lower() == 's':
            paciente_obj = cadastrar_paciente()
            if not paciente_obj: return
        else:
            return

    # 2. Seleção do Médico (NOVO: Listando e Selecionando)
    medico_obj = selecionar_medico()
    if not medico_obj:
        return
    crm = medico_obj.crm # Obtém o CRM do objeto selecionado

    # 3. Exibir Horários Disponíveis e Seleção
    print(f"\n--- Horários Disponíveis de Dr(a). {medico_obj.nome} ({medico_obj.especialidade}) ---")
    if not medico_obj.agenda:
        print("❌ ERRO: Este médico não tem horários de disponibilidade cadastrados.")
        return

    disponibilidade = {}

    for data, horarios_totais in medico_obj.agenda.items():
        try:
            # Pula datas passadas
            data_dt = datetime.strptime(data, "%d/%m/%Y").date()
            if data_dt < date.today():
                 continue
        except ValueError:
            continue # Pula datas com formato inválido no registro

        # Filtra horários que já estão AGENDADOS/CONFIRMADOS
        horarios_ocupados = {
            c.horario for c in consultas
            if c.crm_medico == crm and c.data == data and c.status in ["AGENDADA", "CONFIRMADA"]
        }
        horarios_disponiveis = sorted([h for h in horarios_totais if h not in horarios_ocupados])

        if horarios_disponiveis:
            disponibilidade[data] = horarios_disponiveis

    if not disponibilidade:
        print(">> Não há horários disponíveis ou futuros para este médico.")
        return

    # Exibe a disponibilidade organizada
    print("\n🗓️ Datas e Horários Disponíveis (futuros):")
    datas_ordenadas = sorted(disponibilidade.keys(), key=lambda x: datetime.strptime(x, "%d/%m/%Y"))

    for data in datas_ordenadas:
        print(f"   - {data}: {', '.join(disponibilidade[data])}")

    # 4. Seleção da Data e Horário
    while True:
        data_selecionada = input("\nEscolha a data da consulta (DD/MM/AAAA): ").strip()
        if data_selecionada in disponibilidade:
            break
        print("⚠️ Data inválida ou sem horários disponíveis. Tente novamente.")

    while True:
        horario_selecionado = input("Escolha o horário (HH:MM): ").strip()
        if horario_selecionado in disponibilidade[data_selecionada]:
            break
        print("⚠️ Horário inválido para a data selecionada. Tente novamente.")

    # 5. Criação da Consulta
    nova_consulta = Consulta(paciente_obj.cpf, crm, data_selecionada, horario_selecionado, status="AGENDADA")
    consultas.append(nova_consulta)

    print(f"\n✅ Consulta AGENDADA com sucesso:")
    print(f"   {nova_consulta}")
    salvar_dados()

def confirmar_consulta():
    """Secretária: Altera o status de uma consulta de AGENDADA para CONFIRMADA."""
    # ... (Mantendo a função original)
    print("\n--- Confirmação de Consulta ---")

    consulta_index = input("Digite o NÚMERO da consulta AGENDADA a ser confirmada: ").strip()
    try:
        index = int(consulta_index) - 1
        if 0 <= index < len(consultas):
            consulta = consultas[index]
            if consulta.status == "AGENDADA":
                consulta.status = "CONFIRMADA"
                print(f"\n✅ Consulta de {pacientes[consulta.cpf_paciente].nome} CONFIRMADA para {consulta.data} às {consulta.horario}.")
                salvar_dados()
            elif consulta.status == "CONFIRMADA":
                print("⚠️ Aviso: Esta consulta já está CONFIRMADA.")
            else:
                print(f"❌ Erro: A consulta está com status '{consulta.status}' e não pode ser confirmada.")
        else:
            print("❌ Erro: Número de consulta inválido.")
    except ValueError:
        print("❌ Erro: Entrada inválida. Digite o número da consulta.")

def cancelar_consulta():
    """Secretária/Médico: Altera o status de uma consulta para CANCELADA."""
    # ... (Mantendo a função original)
    print("\n--- Cancelamento de Consulta ---")

    consulta_index = input("Digite o NÚMERO da consulta a ser CANCELADA: ").strip()
    try:
        index = int(consulta_index) - 1
        if 0 <= index < len(consultas):
            consulta = consultas[index]
            if consulta.status in ["AGENDADA", "CONFIRMADA"]:
                consulta.status = "CANCELADA"
                print(f"\n✅ Consulta de {pacientes[consulta.cpf_paciente].nome} CANCELADA. Status atualizado.")
                salvar_dados()
            elif consulta.status == "CANCELADA":
                print("⚠️ Aviso: Esta consulta já estava CANCELADA.")
            else:
                print(f"❌ Erro: A consulta está com status '{consulta.status}' e não pode ser cancelada.")
        else:
            print("❌ Erro: Número de consulta inválido.")
    except ValueError:
        print("❌ Erro: Entrada inválida. Digite o número da consulta.")

