# --- FUNÇÃO GERENCIAR DISPONIBILIDADE MÉDICA ATUALIZADA ---
def gerenciar_disponibilidade_medica():
    """Permite adicionar disponibilidade a um médico existente, exibindo-os para escolha."""
    print("\n--- Gerenciar Disponibilidade ---")

    # Usa a função auxiliar para selecionar o médico
    medico_obj = selecionar_medico()

    if not medico_obj:
        return

    print(f"\n✅ Gerenciando agenda de Dr(a). {medico_obj.nome}")

    # Adicionada validação de data futura
    while True:
        data = input("Digite a data (DD/MM/AAAA) para adicionar horários: ").strip()
        try:
            data_dt = datetime.strptime(data, "%d/%m/%Y").date()
            if data_dt < date.today():
                print("❌ Data inválida. Por favor, insira uma data futura.")
            else:
                break
        except ValueError:
            print("❌ Formato de data inválido. Use DD/MM/AAAA.")

    horarios_input = input("Digite os horários disponíveis separados por vírgula (Ex: 09:00, 10:30): ").strip()

    horarios = [h.strip() for h in horarios_input.split(',') if h.strip()]

    if medico_obj.adicionar_disponibilidade(data, horarios):
        print(f"✅ Horários adicionados para {data}.")
    else:
        print("❌ ERRO: Falha ao adicionar horários.")
    salvar_dados()

